# Project Meridian environment configuration
# Copy to .env.local for local development. Never commit real secrets.

# Required: database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Required: Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Required: API-key encryption. Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_SECRET=""

# Optional: Redis cache and queues
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL="rediss://default:...@...upstash.io:6379"

# Optional: provider-neutral AI synthesis
# Set AI_PROVIDER=disabled to use deterministic analysis only.
AI_PROVIDER="disabled"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Optional: observability and billing
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
